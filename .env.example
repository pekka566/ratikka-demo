# Ratikka Demo Environment Configuration
# Copy this file to .env.development or .env.production and fill in the values

# Skip react-scripts preflight check for ESLint version
SKIP_PREFLIGHT_CHECK=true

# GraphQL API endpoint for Digitransit routing service
# Development: https://api.digitransit.fi/routing/v1/routers/waltti/index/graphql
# Production: Use your production API endpoint
REACT_APP_GRAPHQL_URI=

# Application name displayed in the UI
REACT_APP_NAME=Ratikka Demo

# Enable debug mode (true/false)
REACT_APP_DEBUG=false
