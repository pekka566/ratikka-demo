# Ratikka Demo Environment Configuration
# Copy this file to .env.development or .env.production and fill in the values

# ItsFactory Journeys API Configuration
# API Documentation: http://data.itsfactory.fi/journeys/api/1/
# Base URL: http://data.itsfactory.fi/journeys/api/1/
# No authentication required - public API

# Application name displayed in the UI
VITE_APP_NAME=Ratikka Demo

# Enable debug mode (true/false)
VITE_DEBUG=false

# Default line to display (e.g., "3" for tram line 3)
VITE_DEFAULT_LINE=3
